# ===== Telegram =====
TELEGRAM_BOT_TOKEN=123456:AA...
# ID администраторов через запятую (узнать свой: @userinfobot)
ADMIN_TELEGRAM_IDS=
# Кому разрешено пользоваться подбором (через запятую). Пусто = всем
ALLOWED_TELEGRAM_IDS=

# ===== LLM (OpenAI-совместимый API) =====
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_MS=120000
LLM_MAX_TOKENS=8192

# ===== Goofish =====
# mock = демо-данные из src/goofish/fixtures, http = реальный Goofish (нужны cookie и прокси)
GOOFISH_PROVIDER=mock
# Cookie залогиненного аккаунта goofish.com (обязательно для http)
GOOFISH_COOKIE=
# Прокси для Goofish (желательно китайский): http://user:pass@host:port
GOOFISH_PROXY_URL=

# ===== Деньги (можно задать здесь или командой /rate в боте) =====
# Курс CNY/RUB. Если пусто — рублёвые цены будут null до команды /rate
RATE_CNY_RUB=
COMMISSION_PERCENT=6.5
COMMISSION_MIN_RUB=650

# ===== Агент =====
MAX_TOOL_CALLS=45
MAX_STEPS=60
RUN_TIMEOUT_MS=300000
MAX_CONCURRENT_RUNS=2

# ===== Фото =====
# Сколько фото лота отправлять в Telegram (0 — не отправлять)
SEND_PHOTOS_PER_LOT=4
# off = фото не передаются, photo_check всегда «не проверялось» (DeepSeek картинки не понимает)
# vision = передавать изображения vision-модели (Qwen-VL и подобные)
PHOTO_MODE=off
INLINE_IMAGES=true
IMAGE_MAX_BYTES=6000000

# ===== Прочее =====
DATA_DIR=data
LOG_LEVEL=info

# ===== Хостинг =====
# Если хостинг требует открытый порт, будет поднят GET /health
PORT=
\n# Telegram API: IP-транспорт на случай блокировки DNS\nTELEGRAM_API_IP=149.154.167.220\nTELEGRAM_API_HOST=api.telegram.org\n
# ===== Vision (анализ фото) =====
# Нужен OpenAI-совместимый vision-эндпоинт. DeepSeek картинки не видит.
VISION_ENABLED=false
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
VISION_MAX_PHOTOS=4
