# ===== Telegram =====
TELEGRAM_BOT_TOKEN=123456:AA...
# ID администраторов через запятую (узнать свой: @userinfobot)
ADMIN_TELEGRAM_IDS=
# Кому разрешено пользоваться подбором (через запятую). Пусто = всем
ALLOWED_TELEGRAM_IDS=

# ===== LLM (OpenAI-совместимый API) =====
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_MS=120000
LLM_MAX_TOKENS=8192

# ===== Goofish =====
# mock = демо-данные из src/goofish/fixtures, http = реальный Goofish (нужны cookie и прокси)
GOOFISH_PROVIDER=mock
# Cookie залогиненного аккаунта goofish.com (обязательно для http)
GOOFISH_COOKIE=
# Пул аккаунтов: JSON-массив [{"id":"main","label":"main","cookie":"..."}]
GOOFISH_ACCOUNTS=
# Файл состояния пула (куки, cooldown, счётчики). В git не попадает
GOOFISH_ACCOUNTS_FILE=accounts.json
# Максимум вызовов на аккаунт в сутки
GOOFISH_DAILY_LIMIT=60
# TTL кэша карточек/поиска/продавцов/отзывов, мс
GOOFISH_ITEM_TTL_MS=21600000
GOOFISH_SEARCH_TTL_MS=600000
GOOFISH_SELLER_TTL_MS=43200000
GOOFISH_REVIEWS_TTL_MS=43200000
# Если карточки в cooldown — показывать только результаты поиска
GOOFISH_SEARCH_ONLY_FALLBACK=true
# Сколько кандидатов показывать в аварийном search-only (0-3; 0 = только сообщение)
SEARCH_ONLY_MAX=1
# Прокси для Goofish (желательно китайский): http://user:pass@host:port
GOOFISH_PROXY_URL=

# ===== Деньги (можно задать здесь или командой /rate в боте) =====
# Курс CNY/RUB. Если пусто — рублёвые цены будут null до команды /rate
RATE_CNY_RUB=
COMMISSION_PERCENT=6.5
COMMISSION_MIN_RUB=650

# ===== Агент =====
MAX_TOOL_CALLS=45
MAX_STEPS=60
RUN_TIMEOUT_MS=300000
MAX_CONCURRENT_RUNS=2

# ===== Фото =====
# Сколько фото лота отправлять в Telegram (0 — не отправлять)
SEND_PHOTOS_PER_LOT=4
# off = фото не передаются, photo_check всегда «не проверялось» (DeepSeek картинки не понимает)
# vision = передавать изображения vision-модели (Qwen-VL и подобные)
PHOTO_MODE=off
INLINE_IMAGES=true
IMAGE_MAX_BYTES=6000000

# ===== Прочее =====
DATA_DIR=data
LOG_LEVEL=info

# ===== Хостинг =====
# Если хостинг требует открытый порт, будет поднят GET /health
APP_PORT=

# Telegram API: IP-транспорт на случай блокировки DNS
TELEGRAM_API_IP=149.154.167.220
TELEGRAM_API_HOST=api.telegram.org

# ===== Vision (анализ фото) =====
# Нужен OpenAI-совместимый vision-эндпоинт. DeepSeek картинки не видит.
VISION_ENABLED=false
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
VISION_MAX_PHOTOS=4
# Кэш vision по URL, мс (0 — выключен)
VISION_CACHE_TTL_MS=21600000

# ===== Eval lab =====
# Replay по умолчанию; live — только вручную с --live
EVAL_MODE=replay
EVAL_MAX_TOKENS=250000
EVAL_MAX_COST_CNY=3
